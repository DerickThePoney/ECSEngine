TEXTURE_FLAG(TEXTURE_COMPUTE_WRITE, 0x0000100000000000), //!< Texture will be used for compute write.
TEXTURE_FLAG(TEXTURE_SRGB, 0x0000200000000000), //!< Sample texture as sRGB.
TEXTURE_FLAG(TEXTURE_BLIT_DST, 0x0000400000000000), //!< Texture will be used as blit destination.
TEXTURE_FLAG(TEXTURE_READ_BACK, 0x0000800000000000), //!< Texture will be used for read back from GPU.

TEXTURE_FLAG(TEXTURE_RT_MSAA_X2, 0x0000002000000000), //!< Render target MSAAx2 mode.
TEXTURE_FLAG(TEXTURE_RT_MSAA_X4, 0x0000003000000000), //!< Render target MSAAx4 mode.
TEXTURE_FLAG(TEXTURE_RT_MSAA_X8, 0x0000004000000000), //!< Render target MSAAx8 mode.
TEXTURE_FLAG(TEXTURE_RT_MSAA_X16, 0x0000005000000000), //!< Render target MSAAx16 mode.

TEXTURE_FLAG(TEXTURE_RT_MSAA_MASK, 0x0000007000000000),

TEXTURE_FLAG(TEXTURE_RT_WRITE_ONLY, 0x0000008000000000), //!< Render target will be used for writing
TEXTURE_FLAG(TEXTURE_RT_MASK, 0x000000f000000000),
