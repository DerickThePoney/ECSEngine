{
    VSSolution( '$SolutionName$' )
    {

        .SolutionOutput = '$SolutionOutput$/$SolutionName$.sln'
        .SolutionConfigs = .SolutionConfigs

        .SolutionVisualStudioVersion = '16.8.30717.126'

        .SolutionProjects = {}
        ForEach( .Project in .ProjectList)
        {
          ^SolutionProjects     + "$Project$-Proj"
        }
    }
}