#once
#include "Utils/Compiler.bff"
#include "Utils/SolutionConfigs.bff"
#include "Utils/PreSolutionFile.bff"

.ProjectList = {}
.ProjectIncludePath = {}
.AdditionalLibraryPath = {}
.AdditionalAllTarget = {}
.ForcedTarget = {}
.ExeName = .GameName

.'$GameName$Projects' = {}
.AssetCookerProjects = {}
.DataPackerProjects = {}

#include "Projects/External/Assimp.bff"
#include "Projects/External/RenderingLibs.bff"
#include "Projects/External/boost.bff"
#include "Projects/External/brigand.bff"
#include "Projects/External/cereal.bff"
#include "Projects/External/glm.bff"
#include "Projects/External/polypartition.bff"
#include "Projects/External/fmt.bff"
#include "Projects/External/Tracy.bff"
#include "Projects/External/freetype.bff"
#include "Projects/External/RMLUI.bff"

#include "Projects/AssimpWrapper.bff"

#include "Projects/imgui.bff"
#include "Projects/imguitools.bff"

#include "Projects/DataPack.bff"
#include "Projects/Common.bff"
#include "Projects/Math.bff"
#include "Projects/Application.bff"
#include "Projects/ECSCore.bff"
#include "Projects/RenderingCore.bff"
#include "Projects/UICore.bff"

#include "Projects/ECSGameplay_Common.bff"
#include "Projects/ECSGameplay_Specific.bff"

#include "Projects/Rendering.bff"

#include "Projects/Launcher.bff"
#include "Projects/AssetCooker.bff"
#include "Projects/DataPacker.bff"

{
    .ExeName = .GameName
    .ProjectList = .'$GameName$Projects'
    #include "Utils/Executable.bff"
}

{
    .ExeName = 'DataPacker'
    .ProjectList = .DataPackerProjects
    #include "Utils/Executable.bff"
}


{
    ^AdditionalLibs_x64_Debug + {'assimp-vc142-mtd'}
    ^AdditionalLibs_x64_Release + {'assimp-vc142-mt'}
    ^AdditionalLibs_x64_Final + {'assimp-vc142-mt'}
    ^AdditionalLibs_x64_Profile + {'assimp-vc142-mt'}
    ^AdditionalLibraryPath + {'External\assimpBinaries\Release\', 'External\assimpBinaries\Debug\'}
    .ExeName = 'AssetCooker'
    .ProjectList = .AssetCookerProjects
    #include "Utils/Executable.bff"
}


#include "Utils/BuildSolutionProjects.bff"

{
    .ProjectList = .'$GameName$Projects' + .AssetCookerProjects + .DataPackerProjects
    Print(.ProjectList)
    #include "Utils/SolutionFile.bff"
}

Alias('all')
{
  .Targets = {'$SolutionName$'}
}

ForEach(.SolutionConfig in .SolutionConfigs)
{
    Using(.SolutionConfig)

    {
        .ExeName = 'DataPacker'
        Alias('Build-$ExeName$-$Platform$-$Config$')
        {
            .Targets = {'$ExeName$-Exe-$Platform$-$Config$'}
        }
    }

    {
        .ExeName = 'AssetCooker'
        Alias('Build-$ExeName$-$Platform$-$Config$')
        {
            .Targets = {'$ExeName$-Exe-$Platform$-$Config$', 'AssimpCopy' }
        }
    }

    {
        .ExeName = .GameName
        Alias('Build-$GameName$-$Platform$-$Config$')
        {
            .Targets = {'$GameName$-Exe-$Platform$-$Config$', 'GLFWCopy' }
        }
    }
}