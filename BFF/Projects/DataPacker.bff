#once
{
    .ProjectName = 'DataPacker'
    .ProjectPath = 'SRC/Tools'
    .AdditionnalIncludePaths = {"SRC", "SRC/Tools" }

    .SolutionFolder = 'Tools'

    .ExeName = 'DataPacker'

    #define USE_PRECOMPILED_HEADERS
    .BuildTarget = { '$ExeName$-Exe' }
    #include "../Utils/MakeProjectStandard.bff"
    #undef USE_PRECOMPILED_HEADERS

    ^'$ExeName$Projects' + 'Common' + 'Math' + 'Tracy' + 'imgui' + 'DataPack' + 'ECSCore' + 'Physics' + 'SoundCore' + 'MiniaudioSoundEngine' + 'Application' + 'ECSGameplay_Common' + 'RenderingCore' + 'Rendering' + 'ImguiTools' + 'UICore'
    ^'$ExeName$Projects' + .AllPrototypeLibraries
}